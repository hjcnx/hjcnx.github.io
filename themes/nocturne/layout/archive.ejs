<section class="archive-page container">
  <header class="page-head reveal" data-delay="0">
    <h1 class="page-title">
      <% if (page.category) { %>分类：<%= page.category %>
      <% } else if (page.tag) { %>标签：<%= page.tag %>
      <% } else { %><%= page.title || '归档' %><% } %>
    </h1>
    <p class="page-sub"><%= page.posts.length %> 篇文章</p>
  </header>

  <div class="archive-list">
    <%
    var yearGroups = {};
    page.posts.toArray().forEach(function(p) {
      var y = date(p.date, 'YYYY');
      if (!yearGroups[y]) yearGroups[y] = [];
      yearGroups[y].push(p);
    });
    var years = Object.keys(yearGroups).sort(function(a, b) { return b - a; });
    %>
    <% if (!years.length) { %>
    <p class="posts-empty reveal">这里还什么都没有。</p>
    <% } %>
    <% years.forEach(function(y, yi) { %>
    <div class="archive-year-wrap reveal" data-delay="<%= yi * 60 %>">
      <span class="archive-year"><%= y %></span>
      <span class="archive-count"><%= yearGroups[y].length %> 篇</span>
    </div>
    <% yearGroups[y].forEach(function(p, pi) { %>
    <a class="archive-item reveal" href="<%- url_for(p.path) %>" data-delay="<%= yi * 60 + pi * 60 %>">
      <time datetime="<%= date(p.date, 'YYYY-MM-DD') %>"><%= date(p.date, 'MM-DD') %></time>
      <span class="archive-item-title"><%= p.title || '无标题' %></span>
    </a>
    <% }) %>
    <% }) %>
  </div>

  <%- partial('_partial/pagination') %>
</section>
