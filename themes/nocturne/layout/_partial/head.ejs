<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#0B1322">
<%
var pageTitle = page.title ? page.title + ' · ' + config.title : config.title;
var pageDesc = page.description || (page.excerpt ? String(strip_html(page.excerpt)).trim() : '') || config.description || '';
%>
<title><%= pageTitle %></title>
<meta name="description" content="<%= pageDesc %>">
<link rel="icon" type="image/svg+xml" href="<%- url_for('img/favicon.svg') %>">
<link rel="stylesheet" href="<%- url_for('css/style.css') %>">
<%- open_graph() %>
</head>
