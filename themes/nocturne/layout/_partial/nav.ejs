<div class="container nav-inner">
  <a class="brand" href="<%- url_for('/') %>">
    <span class="brand-dot" aria-hidden="true"></span><%= config.title %>
  </a>
  <nav class="nav-links" aria-label="主导航">
    <% for (var label in theme.menu) { %>
    <a class="nav-link" href="<%- url_for(theme.menu[label]) %>"><%= label %></a>
    <% } %>
  </nav>
  <button class="menu-btn" id="menuBtn" aria-expanded="false" aria-controls="mobileMenu" aria-label="切换菜单">
    <span class="bars" aria-hidden="true"><span></span><span></span></span>
  </button>
</div>
<div class="mobile-menu" id="mobileMenu">
  <% for (var mLabel in theme.menu) { %>
  <a href="<%- url_for(theme.menu[mLabel]) %>"><%= mLabel %></a>
  <% } %>
</div>
