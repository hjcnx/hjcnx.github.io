<section class="hero container" id="top">
  <div class="hero-copy">
    <h1 class="reveal" data-delay="0"><%= theme.hero.title %><em class="gold"><%= theme.hero.title_gold %></em></h1>
    <p class="hero-sub reveal" data-delay="80"><%= theme.hero.subtitle %></p>
    <div class="hero-actions reveal" data-delay="160">
      <a class="btn btn-primary" href="<%- url_for(theme.hero.primary_url) %>">
        <span class="sweep" aria-hidden="true"></span>
        <%= theme.hero.primary_text %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>
        </svg>
      </a>
      <a class="btn btn-ghost" href="<%- url_for(theme.hero.secondary_url) %>"><%= theme.hero.secondary_text %></a>
    </div>
    <%
      var since = new Date(theme.stats.since + 'T00:00:00');
      var days = Math.max(1, Math.ceil((Date.now() - since.getTime()) / 86400000));
    %>
    <dl class="stats reveal" data-delay="240">
      <div class="stat"><dt>文章</dt><dd><%= site.posts.length %></dd></div>
      <div class="stat"><dt>标签</dt><dd><%= site.tags.length %></dd></div>
      <div class="stat"><dt>运行天数</dt><dd><%= days.toLocaleString('en-US') %></dd></div>
    </dl>
  </div>

  <aside class="profile card hoverable reveal" data-delay="200">
    <span class="lumen" aria-hidden="true"></span>
    <span class="sweep" aria-hidden="true"></span>
    <div class="card-body">
      <span class="avatar-ring">
        <% if (theme.profile.avatar) { %>
        <span class="avatar">
          <img src="<%- url_for(theme.profile.avatar) %>" alt="<%= theme.profile.avatar_alt || theme.profile.name %>">
        </span>
        <% } else { %>
        <span class="avatar" role="img" aria-label="<%= theme.profile.avatar_alt || theme.profile.name %>">
          <svg viewBox="0 0 128 128" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
              <radialGradient id="avSky" cx="32%" cy="18%" r="110%">
                <stop offset="0%" stop-color="#1C2E4A"/>
                <stop offset="55%" stop-color="#122036"/>
                <stop offset="100%" stop-color="#0B1322"/>
              </radialGradient>
              <radialGradient id="avGlow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#E4B863" stop-opacity=".28"/>
                <stop offset="100%" stop-color="#E4B863" stop-opacity="0"/>
              </radialGradient>
            </defs>
            <rect width="128" height="128" fill="url(#avSky)"/>
            <circle cx="64" cy="70" r="52" fill="url(#avGlow)"/>
            <circle cx="26" cy="30" r="1.3" fill="#fff" opacity=".55"/>
            <circle cx="102" cy="24" r="1" fill="#fff" opacity=".4"/>
            <circle cx="108" cy="58" r="1.1" fill="#fff" opacity=".45"/>
            <circle cx="20" cy="72" r="1" fill="#fff" opacity=".35"/>
            <circle cx="88" cy="14" r=".9" fill="#fff" opacity=".5"/>
            <circle cx="44" cy="18" r=".9" fill="#fff" opacity=".4"/>
            <text x="64" y="67" text-anchor="middle" dominant-baseline="central"
                  font-family="Playfair Display, Georgia, Songti SC, SimSun, serif"
                  font-size="54" font-weight="600" fill="#F3DCA8" letter-spacing="1"><%= (theme.profile.name || 'N').charAt(0) %></text>
          </svg>
        </span>
        <% } %>
      </span>
      <p class="profile-name"><%= theme.profile.name %></p>
      <p class="profile-handle"><%= theme.profile.handle %></p>
      <p class="profile-bio"><%= theme.profile.bio %></p>
      <div class="socials">
        <% (theme.profile.socials || []).forEach(function(s) { %>
        <a class="icon-btn" href="<%- url_for(s.url) %>"<%= s.url.indexOf('//') > -1 ? ' target="_blank" rel="noopener"' : '' %> aria-label="<%= s.name %>">
          <%- partial('_partial/icon', { name: s.icon }) %>
        </a>
        <% }) %>
      </div>
    </div>
  </aside>
</section>

<section class="posts container" id="posts">
  <div class="posts-head reveal" data-delay="0">
    <h2 class="section-title">最新文章</h2>
    <a class="see-all" href="<%- url_for('/archives') %>">
      查看全部
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>
      </svg>
    </a>
  </div>
  <div class="grid">
    <% if (page.posts.length) { %>
    <% page.posts.forEach(function(post, i) { %>
    <%- partial('_partial/post-card', { post: post, delay: 80 + i * 80 }) %>
    <% }) %>
    <% } else { %>
    <p class="posts-empty reveal">还没有文章——第一篇正在路上。</p>
    <% } %>
  </div>
  <%- partial('_partial/pagination') %>
</section>
