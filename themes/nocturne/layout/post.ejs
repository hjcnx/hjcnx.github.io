<% var post = page; /* Hexo 文章布局中文章对象即 page */ %>
<section class="page-shell container">
  <article class="card article-panel reveal" data-delay="0">
    <span class="lumen" aria-hidden="true"></span>
    <div class="card-body">
      <header class="article-head">
        <div class="post-meta">
          <% var postCats = post.categories ? post.categories.toArray() : []; %>
          <% postCats.forEach(function(c) { %>
          <span class="chip"><%= c.name %></span>
          <% }) %>
          <time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
          <% var postWords = String(strip_html(post.content)).replace(/\s+/g, '').length; %>
          <span class="read-time"><%= Math.max(1, Math.round(postWords / 400)) %> min</span>
        </div>
        <h1 class="article-title"><%= post.title || '无标题' %></h1>
      </header>

      <div class="article-entry">
        <%- post.content %>
      </div>

      <% var postTags = post.tags ? post.tags.toArray() : []; %>
      <% if (postTags.length) { %>
      <footer class="article-foot">
        <div class="tag-row">
          <% postTags.forEach(function(t) { %>
          <a class="chip" href="<%- url_for(t.path) %>"># <%= t.name %></a>
          <% }) %>
        </div>
      </footer>
      <% } %>
    </div>
  </article>

  <%
  /* Hexo 按日期降序排列：post.prev 为较新一篇，post.next 为较早一篇 */
  var newerPost = post.prev;
  var olderPost = post.next;
  %>
  <% if (newerPost || olderPost) { %>
  <nav class="article-nav reveal" data-delay="120" aria-label="文章导航">
    <% if (newerPost) { %>
    <a class="card hoverable article-nav-item prev" href="<%- url_for(newerPost.path) %>">
      <span class="lumen" aria-hidden="true"></span>
      <div class="card-body">
        <span class="article-nav-label">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 12H5"/><path d="m11 18-6-6 6-6"/>
          </svg>
          较新一篇
        </span>
        <span class="article-nav-title"><%= newerPost.title %></span>
      </div>
    </a>
    <% } else { %><span aria-hidden="true"></span><% } %>
    <% if (olderPost) { %>
    <a class="card hoverable article-nav-item next" href="<%- url_for(olderPost.path) %>">
      <span class="lumen" aria-hidden="true"></span>
      <div class="card-body">
        <span class="article-nav-label">
          较早一篇
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>
          </svg>
        </span>
        <span class="article-nav-title"><%= olderPost.title %></span>
      </div>
    </a>
    <% } %>
  </nav>
  <% } %>
</section>
